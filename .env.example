# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=your_strong_password_here
# Standard postgres:// URI (e.g. from Neon/Render). Checked before ConnectionStrings__DefaultConnection
# and the discrete PGHOST/PGPORT/etc vars — see ResolveConnectionString in
# backend/src/SacredVibes.Infrastructure/DependencyInjection.cs.
DATABASE_URL=postgres://user:password@localhost:5432/sacredvibes

# ── API / Backend ─────────────────────────────────────────────────────────────
# REQUIRED: At least 32 random characters
JWT_SECRET=REPLACE_WITH_MINIMUM_32_CHAR_RANDOM_SECRET_KEY_HERE
# Port the API listens on (hosts usually set this for you)
PORT=8080

# Where uploaded media (galleries/assets) is stored. Set Storage__R2__BucketName to use
# Cloudflare R2 (host-independent — same bucket from Railway or Render, so uploads survive
# a failover); leave it unset to fall back to local disk, which is dev-only — a plain
# container filesystem path is wiped on every redeploy and isn't shared between hosts.
# Storage__BaseUrl is currently the bucket's r2.dev dev subdomain (works, but Cloudflare
# doesn't recommend it for production traffic — swap to a custom domain once
# sacredvibesyoga.com's DNS is on Cloudflare).
Storage__BaseUrl=https://pub-267d0851027c4cb99359e77ae1156382.r2.dev
Storage__R2__AccountId=c357fec2f26113e85aeb9ff98c6cfcc9
Storage__R2__AccessKeyId=
Storage__R2__SecretAccessKey=
Storage__R2__BucketName=sacredvibes-uploads
# Local-disk fallback (dev only — ignored once Storage__R2__BucketName is set)
Storage__BasePath=wwwroot/uploads

# ── URLs ──────────────────────────────────────────────────────────────────────
API_BASE_URL=https://api.sacredvibesyoga.com
FRONTEND_URL=https://sacredvibesyoga.com
ADMIN_FRONTEND_URL=https://admin.sacredvibesyoga.com
NEXT_PUBLIC_API_URL=http://localhost:5080

# ── Square (Payment Processing) ───────────────────────────────────────────────
# Get from: https://developer.squareup.com/apps
# Use 'sandbox' for testing, 'production' for live
SQUARE_ENVIRONMENT=sandbox
SQUARE_APP_ID=
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
# Get from Square Developer Dashboard > Webhooks
SQUARE_WEBHOOK_KEY=

# ── Stripe (Contact Import Only — NOT payments) ───────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=

# ── Admin Email Inbox / Sending ───────────────────────────────────────────────
# Preferred production sending path. Verify the sender domain in Resend first.
RESEND_API_KEY=
RESEND_FROM_EMAIL=info@sacredvibesyoga.com
RESEND_FROM_NAME=Sacred Vibes Healing & Wellness
RESEND_REPLY_TO_EMAIL=info@sacredvibesyoga.com

# Used to encrypt saved mailbox credentials. Keep this stable across deploys.
EMAIL_CREDENTIAL_KEY=

# Optional cPanel mailbox overrides. Required for inbox/IMAP and SMTP fallback.
EMAIL_FROM_ADDRESS=info@sacredvibesyoga.com
EMAIL_FROM_NAME=Sacred Vibes Healing & Wellness
EMAIL_USERNAME=info@sacredvibesyoga.com
EMAIL_PASSWORD=
EMAIL_IMAP_HOST=mail.sacredvibesyoga.com
EMAIL_IMAP_PORT=993
EMAIL_IMAP_SSL=true
EMAIL_SMTP_HOST=mail.sacredvibesyoga.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_SSL=true
# How often (seconds) the backend checks the inbox for new mail to push-notify admins about
EMAIL_POLLING_INTERVAL_SECONDS=120

# ── Push Notifications (admin alerts for new bookings/emails) ─────────────────
# Generate with: npx web-push generate-vapid-keys
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=mailto:info@sacredvibesyoga.com
